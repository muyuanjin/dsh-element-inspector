{
  "name": "dsh-element-inspector",
  "version": "0.4.0",
  "description": "元素雷达：识别 DSH 页面元素的插件归属，并永久隐藏不需要的界面元素。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "scoring.js",
    "portability.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "dsh-plugin.json",
    "assets",
    "marketplace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muyuanjin/dsh-element-inspector.git"
  },
  "homepage": "https://github.com/muyuanjin/dsh-element-inspector#readme",
  "bugs": {
    "url": "https://github.com/muyuanjin/dsh-element-inspector/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "element-inspector",
    "plugin-inspector"
  ],
  "scripts": {
    "test": "node --test"
  },
  "author": "muyuanjin",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.8 <0.2.0-0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.8 <0.2.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.8 <0.2.0-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.8 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.8 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "disclosure": {
    "cloud": false,
    "network": "仅访问本机 DSH Host 路由；打开源仓库时由系统浏览器访问插件 package.json 中声明的 URL。",
    "offlineMode": true,
    "apiKeys": false,
    "permissions": [
      "读取当前 DSH web profile 中已安装插件的文本源码以匹配元素归属",
      "通过操作系统文件管理器打开已安装插件目录",
      "通过 DSH 官方 settings 服务保存快捷键和元素隐藏规则"
    ],
    "jurisdiction": "本地运行，不上传数据",
    "retention": "仅在本机保留快捷键和隐藏规则，用户可在插件设置中清除隐藏规则"
  },
  "license": "MIT"
}
