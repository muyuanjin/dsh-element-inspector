{
  "manifest": 1,
  "id": "dsh-element-inspector",
  "name": "dsh-element-inspector",
  "version": "0.5.0",
  "description": "Identify whether a DSH UI element belongs to the host interface or an installed plugin, then export or hide it.",
  "repository": "https://github.com/muyuanjin/dsh-element-inspector",
  "license": "MIT",
  "compatibility": {
    "dsh": ">=0.1.0-rc.8 <0.2.0-0",
    "platforms": ["web", "desktop"],
    "os": ["windows", "linux", "macos"]
  },
  "entrypoints": {
    "host": "./index.js",
    "client": "./client.js"
  },
  "permissions": [
    "read-installed-plugin-sources",
    "open-installed-plugin-folder",
    "write-clipboard",
    "download-element-screenshot",
    "dsh-settings"
  ]
}
